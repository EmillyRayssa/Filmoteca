<div id="<%= dom_id movie %>">
  <div>
    <strong>Title:</strong>
    <%= movie.title %>
  </div>

  <div>
    <strong>Director:</strong>
    <%= movie.director %>
  </div>

  <div>
    <strong>Genre:</strong>
    <%= movie.genre %>
  </div>

  <div>
    <strong>Release year:</strong>
    <%= movie.release_year %>
  </div>

  <div>
    <strong>Rating:</strong>
    <%= movie.rating %>
  </div>

  <div>
    <strong>Synopsis:</strong>
    <%= movie.synopsis %>
  </div>

</div>
